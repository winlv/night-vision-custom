[OVERLAY name = Heatmap, ctx = Canvas, version = 1.0.0]

prop('colorScaleAsks', {type: 'string', def: {
        'BINANCE_FUTURES': (value) => gradient(value, 'asks')(value),
        'BINANCE_SPOT': (value) => gradient(value, 'asks')(value),
        'BYBIT_SPOT': (value) => gradient(value, 'asks')(value),
        'OKX_SPOT': (value) => gradient(value, 'asks')(value)
    }});
prop('colorScaleBids', {type: 'string', def: {
        'BINANCE_FUTURES': (value) => gradient(value, 'asks')(value),
        'BINANCE_SPOT': (value) => gradient(value, 'asks')(value),
        'BYBIT_SPOT': (value) => gradient(value, 'asks')(value),
        'OKX_SPOT': (value) => gradient(value, 'asks')(value)
    }});

prop('showLabels',     { type: 'boolean', def: true });
prop('aggregationStep', { type: 'number', def: 0 });

let cellHeightStep = 0;

let _asksScale = null;
let _bidsScale = null;
let _compactFmt = null;
const SPOOF_VOLUME_MIN = 300000;
const QTY_TOLERANCE = 0.1;

let processedData;

const _volFmt = new Intl.NumberFormat('en', {
    notation: 'compact',
    maximumFractionDigits: 1
});
let maxVolumesMap = {};

const EXCHANGES_CONFIG = {
    'bi-s': 'BINANCE_SPOT',
    'bi-f': 'BINANCE_FUTURES',
    'by-s': 'BYBIT_SPOT',
    'by-f': 'BYBIT_FUTURES',
    'okx-s': 'OKX_SPOT',
    'okx-f': 'OKX_FUTURES',
    'mexc-s': 'MEXC_SPOT',
    'mexc-f': 'MEXC_FUTURES',
    'gate-s': 'GATE_SPOT',
    'gate-f': 'GATE_FUTURES',
    'bit-s': 'BITGET_SPOT',
    'bit-f': 'BITGET_FUTURES'
};

function init() {
    _compactFmt = new Intl.NumberFormat('en', { notation: 'compact' });
}

function draw(ctx) {
    if (!$core.meta?.heatmap) return;

    const flags = window?.[$core.props.id] || {};

    if (flags.redraw === undefined) {
        flags.redraw = true;
    }

    if (flags.redraw || flags.redrawNew || flags.redrawLast || flags.drawMore) {
        const data = $core.data;
        const step = $props.aggregationStep;

        processedData = data.map(row => {
            const ts = row[0];
            const levels = row[1];

            const aggA = step > 0 ? aggregateLevels(levels.a, step) : levels.a;
            const aggB = step > 0 ? aggregateLevels(levels.b, step) : levels.b;

            const findMax = (levs) => {
                for (let k = 0; k < levs.length; k += 3) {
                    const price = levs[k];
                    const qty = levs[k+1];
                    const exId = levs[k+2];

                    const exName = EXCHANGES_CONFIG[exId] || 'UNKNOWN';
                    const v = price * qty;

                    if (!maxVolumesMap[exName] || v > maxVolumesMap[exName]) {
                        maxVolumesMap[exName] = v;
                    }
                }
            }

            const x = $core.layout.ti2xWithoutRound(ts);
            if (x >= 0 && x <= $core.layout.width) {
                findMax(aggA);
                findMax(aggB);
            }

            return [ts, { a: aggA, b: aggB }];
        });

        // calculateSpoofing(processedData);
        clearFlags(flags);
    }

    updateGPUData();
    drawVolumeLabels(ctx);
    // drawSpoofingLines(ctx);
}

function calculateSpoofing(data) {
    spoofingLines = [];
    if (data.length < 2) return;

    for (let i = 1; i < data.length; i++) {
        const prevLevels = data[i-1][1];
        const currLevels = data[i][1];
        const tsPrev = data[i-1][0];
        const tsCurr = data[i][0];

        const findMoves = (sidePrev, sideCurr) => {
            if (!sidePrev || !sideCurr) return;

            for (let j = 0; j < sidePrev.length; j += 3) {
                const pPrev = sidePrev[j];
                const qPrev = sidePrev[j+1];
                const vPrev = pPrev * qPrev;

                if (vPrev < SPOOF_VOLUME_MIN) continue;

                const stillThere = sideCurr.some((p, idx) => idx % 3 === 0 && p === pPrev);

                if (!stillThere) {
                    for (let k = 0; k < sideCurr.length; k += 3) {
                        const pCurr = sideCurr[k];
                        const qCurr = sideCurr[k+1];
                        const vCurr = pCurr * qCurr;

                        const isSimilarQty = Math.abs(vCurr - vPrev) / vPrev < QTY_TOLERANCE;

                        if (pCurr !== pPrev && isSimilarQty) {
                            spoofingLines.push({
                                x1: tsPrev,
                                y1: pPrev,
                                x2: tsCurr,
                                y2: pCurr,
                                side: sidePrev === prevLevels.a ? 'ask' : 'bid'
                            });
                            break;
                        }
                    }
                }
            }
        };

        findMoves(prevLevels.a, currLevels.a);
        findMoves(prevLevels.b, currLevels.b);
    }
}

function drawSpoofingLines(ctx) {

    const layout = $core.layout;
    const step = $props.aggregationStep || (1 / Math.pow(10, layout.prec));

    ctx.save();
    ctx.lineWidth = 2;
    ctx.setLineDash([5, 3]);

    for (const line of spoofingLines) {
        const x1 = layout.ti2xWithoutRound(line.x1);
        const x2 = layout.ti2xWithoutRound(line.x2);

        const y1 = layout.value2y(line.y1 + step / 2);
        const y2 = layout.value2y(line.y2 + step / 2);

        if (x2 < 0 || x1 > layout.width) continue;

        ctx.beginPath();
        ctx.strokeStyle = line.side === 'ask' ? '#ff4d4d' : '#00ff80';
        ctx.globalAlpha = 0.6;
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
    }
    ctx.restore();
}

function drawVolumeLabels(ctx) {
    const layout = $core.layout;
    const data = processedData;
    if (!data || !data.length) return;

    const cellWidth = layout.pxStep;
    const tickStep = 1 / Math.pow(10, layout.prec);
    const step = $props.aggregationStep || tickStep;

    const y1 = layout.value2y(0);
    const y2 = layout.value2y(step);
    const cellHeight = Math.abs(y1 - y2);

    if (cellHeight < 7 || cellWidth < 35) return;

    ctx.font = `bold ${Math.min(12, cellHeight * 0.6)}px Arial`;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    ctx.fillStyle = 'white';
    ctx.shadowColor = 'rgba(0, 0, 0, 1)';
    ctx.shadowBlur = 4;

    for (let i = 0; i < data.length; i++) {
        const [timestamp, levels] = data[i];
        const x = layout.ti2xWithoutRound(timestamp);

        if (x + cellWidth/2 < 0 || x - cellWidth/2 > layout.width) continue;

        const drawLabels = (orders) => {
            if (!orders) return;
            for (let j = 0; j < orders.length; j += 3) {
                const price = orders[j];
                const qty = orders[j+1];

                const y = layout.value2y(price + step / 2);

                if (y < 0 || y > layout.height) continue;

                ctx.fillText(_volFmt.format(qty), x, y);
            }
        };

        drawLabels(levels.a);
        drawLabels(levels.b);
    }

    ctx.restore();
}

function aggregateLevels(levels, step) {
    if (!step || step <= 0) return levels;

    const aggregated = new Map();
    for (let i = 0; i < levels.length; i += 2) {
        const price = levels[i];
        const quantity = levels[i + 1];
        const exchange = levels[i + 2];

        const bucketPrice = Math.floor(price / step) * step;

        const currentData = aggregated.get(bucketPrice) || { qty: 0, ex: exchange };
        aggregated.set(bucketPrice, {
            qty: currentData.qty + quantity,
            ex: exchange
        });
    }

    const result = [];
    for (let [p, data] of aggregated) {
        result.push(p, data.qty, data.ex);
    }
    return result;
}

function clearFlags(flags) {
    flags.redraw = false;
    flags.redrawNew = false;
    flags.redrawLast = false;
    flags.drawMore = false;
    window[$core.props.id] = flags;
}

let prevRange = "";
function updateGPUData() {
    const step = $props.aggregationStep;

    const crntRange = JSON.stringify($core.range) + $core.layout.$hi + $core.layout.$low;

    if (prevRange === crntRange) {
        return;
    }

    $core.meta.heatmap.updateData(
        processedData,
        $core.layout,
        $core.props,
        $props.colorScaleAsks,
        $props.colorScaleBids,
        step,
        getExchangeName,
        maxVolumesMap
    );

    prevRange = crntRange;
}

function getStage() {
    return $core.meta.heatmap.heatmapApp.stage;
}

const getAskColor = (exchange, v) => $props.colorScaleAsks[exchange]?.(v);
const getBidColor = (exchange, v) => $props.colorScaleBids[exchange]?.(v);

const getExchangeName = exchangeId => {
    switch (exchangeId) {
        case 'bi-s':
            return 'BINANCE_SPOT';
        case 'bi-f':
            return 'BINANCE_FUTURES';
        case 'by-s':
            return 'BYBIT_SPOT';
        case 'by-f':
            return 'BYBIT_FUTURES';
        case 'okx-s':
            return 'OKX_SPOT';
        case 'okx-f':
            return 'OKX_FUTURES';
        case 'mexc-s':
            return 'MEXC_SPOT';
        case 'mexc-f':
            return 'MEXC_FUTURES';
        case 'gate-s':
            return 'GATE_SPOT';
        case 'gate-f':
            return 'GATE_FUTURES';
        case 'bit-s':
            return 'BITGET_SPOT';
        case 'bit-f':
            return 'BITGET_FUTURES';
        default:
            return 'UNKNOWN_EXCHANGE';
    }
}

function inRange(price, value) {
    return (value <= price) && (value >= (price - cellHeightStep));
}

function gradient(val, type) {
    const max_value = maxVolumesMap['BINANCE_FUTURES'];
    let opacityMin = 0.3;
    const opacityMax = 1;

    const mid = (opacityMin + max_value) / 2;
    opacityMin = Math.max(opacityMin, 0.1);
    const range = [rgba('#440154', opacityMin), rgba('#219e89', mid), rgba('#fde725', opacityMax)]

    if (type === 'asks') {
        return d3.scalePow()
            .exponent(2)
            .range(range)
            .domain([0, max_value * 0.5, max_value])
            .clamp(true);
    }

    if (type === 'bids') {
        return d3.scalePow()
            .exponent(2)
            .range(range)
            .domain([0, max_value * 0.5, max_value])
            .clamp(true);
    }
}

function rgba (hex, alpha) {
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    return `rgba(${r}, ${g}, ${b}, ${alpha})`;
};

static yRange(data) {
    let len = data.length
    var h, l, high = -Infinity, low = Infinity
    for (var i = 0; i < len; i++) {
        let point = data[i]
        if (point[2] > high) high = point[2]
        if (point[3] < low) low = point[3]
    }
    return [high, low]
}

legend()
=>
[]

// Navy ~ 0.2-lite
// <ds>Drawing lines [Tap + Hold]</ds>

[OVERLAY name = LineTool, ctx = Canvas, version = 1.1.0]

prop('color', {type: 'color', def: '#dc9800'});
prop('lineWidth', {type: 'number', def: 1});
prop('lineType', {type: 'string', def: 'solid'});
prop('textColor', {type: 'color', def: '#dc9800'});
prop('textSize', {type: 'number', def: 12});

let timeId = null;
let mouseX = 0;
let lines = {};
let activeUuid = null;
let pressedShift = false;

init()
{
    $core.dataExt.lines = $core.data;

    // Restore lines from dataExt
    for (const line of $core.dataExt.lines || []) {
        lines[line.uuid] = new $lib.TrendLine($core, line)
        lines[line.uuid].onSelect = lineSelected
    }
}

function draw(ctx) {
    const dataUuids = new Set(($core.dataExt.lines || []).map(l => l.uuid));
    for (const uuid in lines) {
        if (!dataUuids.has(uuid)) delete lines[uuid];
    }

    for (const line of Object.values(lines)) {
        line.draw(ctx);
    }
}

function newLine() {
    if (unfinishedLines() || mouseMoved()) return;

    $core.dataExt.lines = $core.dataExt.lines || [];

    let t = $core.cursor.time;
    let v = $core.layout.y2value($core.cursor.y);
    let uuid = $lib.Utils.uuid3();

    let lineData = {
        type: 'segment',
        p1: [t, v],
        p2: [t, v],
        lineWidth: $props.lineWidth,
        lineType: $props.lineType,
        color: $props.color,
        uuid: uuid,
        textColor: $props.textColor,
        textSize: $props.textSize,
        text: ""
    };

    $core.dataExt.lines.push(lineData);
    const inst = new $lib.TrendLine($core, lineData, true);
    lines[uuid] = inst;

    lineSelected(uuid);
    $events.emit('scroll-lock', true);
    $events.emit('update-layout');
}

function lineSelected($uuid) {
    if (!$uuid) {
        $events.emit('object-selected', {id: undefined, type: undefined});
    }

    for (const uuid in lines) {
        const selected = uuid === $uuid;
        lines[uuid].selected = selected;
        if (selected) {
            setTimeout(() => $events.emit('object-selected', {id: uuid, type: 'LineTool'}));
        }
    }

    $events.emit('update-layout')
}

function unfinishedLines() {
    return Object.values(lines).some(l => l.pins.some(p => p.state !== 'settled'));
}

function mouseMoved() {
    return Math.abs(mouseX - $core.mouse.x) > 5;
}

function removeLine(uuid) {
    delete lines[uuid];
    $core.dataExt.lines = $core.dataExt.lines.filter(x => x.uuid !== uuid);
    $events.emit('change-tool-data', { data: $core.dataExt.lines, id: $core.id });
    $events.emit('update-layout');
    lineSelected(null);
}

function mousedown(event) {
    let clicked = null;
    pressedShift = event.shiftKey;
    const entries = Object.entries(lines).reverse();
    for (const [uuid, line] of entries) {
        if (line.collision()) {
            clicked = uuid;
            break;
        }
    }

    if (clicked) {
        lineSelected(clicked);
        lines[clicked].mousedown(event);
    } else {
        lineSelected(null);
        if ($core.meta.tool === 'LineTool') {
            timeId = setTimeout(newLine, 0);
            mouseX = $core.mouse.x;
        }
    }

    propagate('mousedown', event);
}

function mousemove(event) {
    pressedShift = event.shiftKey;
    propagate('mousemove', event);

    if ($core.meta.tool !== 'Cursor' && $core.meta.tool !== 'LineTool') return;

    let hoverPin = false;
    let hoverLine = false;

    for (const line of Object.values(lines)) {
        if (line.pins.some(p => p.hover())) hoverPin = true;
        else if (line.collision()) hoverLine = true;
    }

    if (hoverPin) $core.cursor.style = 'nwse-resize';
    else if (hoverLine) $core.cursor.style = 'move';
    else $core.cursor.style = null;
}

function mouseup(event) {
    pressedShift = event.shiftKey;
    clearTimeout(timeId)
    timeId = null
    propagate('mouseup', event);

    if ($core.meta.tool === 'LineTool') {
        $events.emit('drawing-mode-off');
    }

    let s = Object.values(lines).find(x => x.selected);
    if (s) {
        $events.emit('change-tool-data', { data: $core.dataExt.lines, id: $core.id });
    }
}

let pressedAlt = false;
function keydown(event) {
    if ((event.code === 'Backspace' || event.code === 'Delete')) {
        let s = Object.values(lines).find(x => x.selected)
        if (s) removeLine(s.data.uuid)
    }

    if (pressedAlt && event.code === 'KeyT') {
        timeId = setTimeout(newLine, 0)

        mouseX = $core.mouse.x;
        lineSelected(null);
        $events.emit('update-layout');
    }
    pressedAlt = event.code.toLowerCase().includes('alt');
}

function keyup(event) {
    pressedAlt = false;
}

function propagate(name, data) {
    for (const line of Object.values(lines)) {
        if (line[name]) line[name](data);
    }
}
// [OVERLAY name = Text, ctx = Canvas, version = 1.0.3, author = Dmitry]

prop('textColor', {type: 'color', def: '#ffffff'}); // Тип color для удобной палитры
prop('textSize', {type: 'number', def: 16});

let texts = {};
let activeUuid = null;
let isEditingNow = false;

function init() {
    $core.dataExt.texts = $core.data || [];
    // Инициализация существующих объектов
    $core.dataExt.texts.forEach(data => {
        if (!texts[data.uuid]) {
            texts[data.uuid] = new $lib.Text($core, data);
        }
    });
}

function draw(ctx) {
    // Удаляем те, которых больше нет в данных
    const dataUuids = new Set($core.dataExt.texts.map(t => t.uuid));
    Object.keys(texts).forEach(uuid => {
        if (!dataUuids.has(uuid)) delete texts[uuid];
    });

    for (const t of Object.values(texts)) {
        t.draw(ctx);
    }
}

function mousedown(event) {
    if (isEditingNow) {
        document.getElementById('canvas-text-tool-editor')?.blur();
        return;
    }

    let clickedUuid = null;
    // Ищем попадание по тексту (в обратном порядке, чтобы брать верхний)
    const entries = Object.entries(texts).reverse();
    for (const [uuid, textObj] of entries) {
        if (textObj.collision()) {
            clickedUuid = uuid;
            break;
        }
    }

    if (clickedUuid) {
        if (activeUuid === clickedUuid) {
            startTextEdit(texts[clickedUuid]);
        } else {
            selectTool(clickedUuid);
        }
        texts[clickedUuid].mousedown(event);
    } else {
        if ($core.meta.tool === 'Text') {
            createNewText();
        } else {
            selectTool(null);
        }
    }
}

function createNewText() {
    let uuid = $lib.Utils.uuid3();
    const toolData = {
        x: $core.cursor.time,
        y: $core.layout.y2value($core.cursor.y),
        text: "",
        textColor: $props.textColor,
        textSize: $props.textSize,
        uuid: uuid
    };

    $core.dataExt.texts.push(toolData);
    const newText = new $lib.Text($core, toolData);
    texts[uuid] = newText;

    selectTool(uuid);
    startTextEdit(newText);
}

function startTextEdit(textObj) {
    let textarea = document.getElementById('canvas-text-tool-editor');
    if (!textarea) {
        textarea = document.createElement('textarea');
        textarea.id = 'canvas-text-tool-editor';
        Object.assign(textarea.style, {
            position: 'absolute', zIndex: '1000', background: 'rgba(30, 30, 30, 0.95)',
            color: 'white', border: '1px solid #3399ff', outline: 'none',
            padding: '6px', resize: 'both', overflow: 'hidden', borderRadius: '4px',
            boxShadow: '0 4px 15px rgba(0,0,0,0.5)', minWidth: '50px'
        });
        document.body.appendChild(textarea);
    }

    const chartRect = $core.hub.se.chart.root.getBoundingClientRect();
    const updatePosition = () => {
        const x = $core.layout.time2x(textObj.data.x) + chartRect.left;
        const y = $core.layout.value2y(textObj.data.y) + chartRect.top;
        textarea.style.left = `${x - 6}px`;
        textarea.style.top = `${y - 6}px`;
    };

    updatePosition();
    textarea.style.display = 'block';
    textarea.style.fontSize = `${textObj.data.textSize}px`;
    textarea.style.color = textObj.data.textColor;
    textarea.style.fontFamily = 'Roboto, Arial, sans-serif';
    textarea.value = textObj.data.text;

    isEditingNow = true;
    textObj.typing = true;

    setTimeout(() => {
        textarea.focus();
        textarea.setSelectionRange(textarea.value.length, textarea.value.length);
    }, 10);

    textarea.oninput = () => {
        textObj.data.text = textarea.value;
        // Авто-подбор высоты textarea
        textarea.style.height = 'auto';
        textarea.style.height = textarea.scrollHeight + 'px';
        $events.emit('update-layout');
    };

    textarea.onblur = () => {
        if (!isEditingNow) return;
        textObj.data.text = textarea.value.trim();
        textObj.typing = false;
        isEditingNow = false;
        textarea.style.display = 'none';

        if (!textObj.data.text) {
            removeTool(textObj.data.uuid);
        } else {
            saveData();
        }
        $events.emit('update-layout');
    };

    textarea.onkeydown = (e) => {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) textarea.blur();
        if (e.key === 'Escape') {
            textarea.value = textObj.data.text; // Отмена правок
            textarea.blur();
        }
        e.stopPropagation();
    };
}

function selectTool(uuid) {
    activeUuid = uuid;
    Object.keys(texts).forEach(id => texts[id].selected = (id === uuid));
    $events.emit('object-selected', { id: uuid || undefined, type: uuid ? 'Text' : undefined });
    $events.emit('update-layout');
}

function removeTool(uuid) {
    delete texts[uuid];
    $core.dataExt.texts = $core.dataExt.texts.filter(x => x.uuid !== uuid);
    saveData();
    selectTool(null);
}

function saveData() {
    $events.emit('change-tool-data', { data: $core.dataExt.texts, id: $core.id });
}

function mousemove(event) {
    for (const t of Object.values(texts)) t.mousemove(event);
}

function mouseup(event) {
    for (const t of Object.values(texts)) t.mouseup(event);
    if (activeUuid && !isEditingNow) saveData();
}

function keydown(event) {
    if (isEditingNow) return;
    if ((event.code === 'Backspace' || event.code === 'Delete') && activeUuid) {
        removeTool(activeUuid);
    }
}
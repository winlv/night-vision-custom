[OVERLAY name = Circle, ctx = Canvas, version = 1.0.0, author = Dmitry]

prop('color', {type: 'string', def: '#cccccc'});
prop('lineWidth', {type: 'number', def: 2});
prop('lineType', {type: 'string', def: 'solid'});
prop('fillColor', {type: 'string', def: '#ffffff'});

let timeId = null;
let mouseX = 0;
let circles = {}
let pressedShift = false;
let selectTimeoutId = null;

function init() {
    $core.dataExt.circles = $core.data;

    for (const circle of $core.dataExt.circles || []) {
        circles[circle.uuid] = new $lib.CircleDrawing($core, circle);
        circles[circle.uuid].onSelect = circleSelected;
    }
}

function draw(ctx) {
    const extUuids = new Set(($core.dataExt.circles || []).map(c => c.uuid));
    for (const uuid of Object.keys(circles)) {
        if (!extUuids.has(uuid)) delete circles[uuid];
    }

    for (const circle of Object.values(circles)) {
        circle.draw(ctx)
    }
}

let pressedAlt = false;
function keydown(event) {
    if (event.code === 'Backspace' || event.code === 'Delete') {
        let s = Object.values(circles).find(x => x.selected)
        if (s) removeCircle(s.data.uuid)
    }

    if (event.code.toLowerCase().includes('alt')) pressedAlt = true;

    if (event.code.toLowerCase().includes('shift')) {
        pressedShift = true;
        $events.emit('update-layout');
    }
}

function keyup(event) {
    if (event.code.toLowerCase().includes('alt')) pressedAlt = false;

    if (event.code.toLowerCase().includes('shift')) {
        pressedShift = false;
        $events.emit('update-layout');
    }
}

function mousedown(event) {
    pressedShift = event.shiftKey;
    if ($core.meta.tool !== 'Circle') {
        circleSelected(null);
        $events.emit('update-layout');
        propagate('mousedown', event);
        return void 0;
    }

    mouseX = $core.mouse.x;
    circleSelected(null);
    $events.emit('update-layout');
    propagate('mousedown', event);
    newCircle();
}

function mouseup(event) {
    pressedShift = event.shiftKey;
    clearTimeout(timeId)
    timeId = null
    propagate('mouseup', event);
    if ($core.meta.tool === 'Circle') {
        $events.emit('drawing-mode-off');
    }

    let s = Object.values(circles).find(x => x.selected);
    if (s) {
        $events.emit('change-tool-data', {
            data: $core.dataExt.circles,
            id: $core.id
        });
    }

    $events.emit('scroll-lock', false);
}

function mousemove(event) {
    pressedShift = event.shiftKey;
    propagate('mousemove', event);
}

function mouseMoved() {
    let d = Math.abs(mouseX - $core.mouse.x)
    return d > 5
}

function removeCircle(uuid) {
    delete circles[uuid]
    $core.dataExt.circles = $core.dataExt.circles?.filter(x => x.uuid !== uuid) ?? [];
    $events.emit('update-layout')

    $events.emit('change-tool-data', {
        data: $core.dataExt.circles,
        id: $core.id
    });

    $events.emit('object-selected', {id: undefined, type: undefined});
}

function newCircle() {
    if (mouseMoved()) {
        return void 0;
    }

    if (!$core.dataExt.circles) {
        $core.dataExt.circles = []
    }

    let time = $core.layout.x2time($core.cursor.x);
    let yValue = $core.layout.y2value($core.cursor.y);
    let uuid = $lib.Utils.uuid3();

    let circle = {
        p1: [time, yValue],
        p2: [time, yValue],
        lineWidth: $props.lineWidth,
        color: $props.color,
        fillColor: $props.fillColor,
        lineType: $props.lineType,
        uuid: uuid
    };

    $core.dataExt.circles.push(circle);

    circles[uuid] = new $lib.CircleDrawing($core, circle, true);
    circles[uuid].onSelect = circleSelected;
    circles[uuid].selected = true;
    circles[uuid].state = 'tracking';

    $events.emit('scroll-lock', true);
    $events.emit('update-layout');

    $events.emit('change-tool-data', {
        data: $core.dataExt.circles,
        id: $core.id
    });
}

function propagate(name, data) {
    for (const circle of Object.values(circles)) {
        circle[name](data)
    }
}

function circleSelected($uuid) {
    clearTimeout(selectTimeoutId);
    if (!$uuid) {
        $events.emit('object-selected', {id: undefined, type: undefined});
    }

    for (const uuid in circles) {
        const selected = uuid === $uuid;
        circles[uuid].selected = selected;
        if (selected) {
            selectTimeoutId = setTimeout(() => $events.emit('object-selected', {id: uuid, type: 'Circle'}));
        }
    }

    $events.emit('update-layout')
}

    const yOpen  = (layout.value2y(open,  false) - stage.position.y) / scaleY;
    const yClose = (layout.value2y(close, false) - stage.position.y) / scaleY;
    const yHigh  = (layout.value2y(high,  false) - stage.position.y) / scaleY;
    const yLow   = (layout.value2y(low,   false) - stage.position.y) / scaleY;

    const candleWidth = cellWidth * 0.8;
    const bodyColor   = close >= open ? '#41a376' : '#de4646';

    graphics.beginFill(bodyColor);
    graphics.drawRect(
      (x - candleWidth / 2) + candleWidth / 8,
      Math.min(yOpen, yClose),
      candleWidth,
      Math.abs(yClose - yOpen)
    );
    graphics.endFill();
    */
}

function drawLabel(ctx) {
    ctx.font = '9px Quantico';
    ctx.fillStyle = (window.theme === 'dark') ? 'rgba(255, 255, 255, .75)' : 'rgba(0, 0, 0, .75)';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';

    const data   = $core.data;
    const view   = $core.view;
    const layout = $core.layout;
    const hi     = layout.$hi;

    ctx.beginPath();

    let showLimitOrdersFilter = 100_000;
    const name = $core.hub.mainOv.name || '';
    if (name.includes('BTC')) showLimitOrdersFilter = 1_000_000;
    else if (name.includes('ETH')) showLimitOrdersFilter = 1_000_000;
    else if (name.includes('XRP') || name.includes('BNB')) showLimitOrdersFilter = 500_000;

    for (let i = view.i1, n = view.i2; i <= n; i++) {
        const timestamp = data[i][0];
        const x = layout.ti2xWithoutRound(timestamp);

        const sides = [data[i][1].a, data[i][1].b];

        sides.forEach(side => {
            for (let j = 0; j < side.length; j += 2) {
                const price    = side[j];
                if (price > hi) continue;
                const quantity = side[j + 1];
                const exchange = slide[j + 2];

                const y = layout.value2y(price, false);
                if (price * quantity > showLimitOrdersFilter) {
                    const value = convertPrice(price * quantity);
                    if (value) ctx.fillText(value, x, y - 5);
                }
            }
        });
    }
    ctx.closePath();
}

function handleHoveredLimitOrders(ctx) {
    const data    = $core.data;
    const metrics = getCellMetrics();

    let cellHeightPx = firstChildCellHeightPxOr(metrics);
    cellHeightPx = Math.max(cellHeightPx, 2);

    cellHeightStep = $core.layout.y2value(0) - $core.layout.y2value(cellHeightPx);

    if (!hoveredLimitOrder) return;

    const xTs = parseInt(hoveredLimitOrder.x);
    const hoveredColumn = data.find(([timestamp]) => parseInt(timestamp) === xTs);
    hoveredTimestamp = hoveredColumn ? hoveredColumn[0] : 0;
    const yHoveredData = hoveredColumn ? hoveredColumn[1] : undefined;

    hoveredYAskValue = undefined;
    hoveredYBidValue = undefined;
    hoveredExchangeCode = undefined;

    if (hoveredTimestamp && yHoveredData) {
        const yVal = parseFloat(hoveredLimitOrder.y);

        const hoveredAsk = findPriceInLevels(yHoveredData.a, yVal);
        const hoveredBid = findPriceInLevels(yHoveredData.b, yVal);

        if (hoveredAsk) {
            hoveredYAskValue = hoveredAsk.price;
            hoveredExchangeCode = hoveredAsk.exchange;
        }

        if (hoveredBid) {
            hoveredYBidValue = hoveredBid.price;
            hoveredExchangeCode = hoveredBid.exchange;
        }
    }
}

function drawHoveredLimitOrders(ctx) {
    const data    = $core.data;
    const view    = $core.view;
    const layout  = $core.layout;
    const metrics = getCellMetrics();

    const stageChild = safeStageFirstChild();
    if (!stageChild) return;

    let cellHeightPx = firstChildCellHeightPxOr(metrics);
    cellHeightPx = Math.max(cellHeightPx, 1);

    let xColumnsToHighlight = [];
    if (hoveredTimestamp) {
        xColumnsToHighlight = getRowsToHighlight(hoveredTimestamp, view, data);
    }

    const hoveredYValue = hoveredYAskValue ?? hoveredYBidValue;
    if (!hoveredYValue) return;

    ctx.strokeStyle = document.body.classList.contains('light-theme') ? 'black' : 'white';
    ctx.lineWidth = 1;

    const cellWidth = $core.layout.pxStep; // как в оригинале
    for (const timestamp of xColumnsToHighlight) {
        const x = layout.ti2xWithoutRound(timestamp) - (cellWidth / 2);
        const y = layout.value2y(hoveredYValue);
        ctx.strokeRect(x, y, cellWidth, cellHeightPx);
    }
}

function getRowsToHighlight(hoveredTimestamp, view, data) {
    const idx = data.findIndex((value) => value[0] === hoveredTimestamp);
    if (idx < 0) return [];

    let askLimitOrder = false;
    const col = data[idx][1];
    const yVal = parseFloat(hoveredLimitOrder.y);
    if (levelsHasPrice(col.a, yVal)) askLimitOrder = true;

    const res = [ data[idx][0] ];

    for (let i = idx + 1; i <= view.i2; i++) {
        if (limitOrderExists(data[i], askLimitOrder)) res.push(data[i][0]);
        else break;
    }

    for (let i = idx - 1; i >= view.i1; i--) {
        if (limitOrderExists(data[i], askLimitOrder)) res.push(data[i][0]);
        else break;
    }

    return res;
}

function limitOrderExists(row, askLimitOrder) {
    const yVal = parseFloat(hoveredLimitOrder.y);
    if (askLimitOrder) {
        return levelsHasPrice(row[1].a, yVal);
    } else {
        return levelsHasPrice(row[1].b, yVal);
    }
}

function inRange(price, value) {
    return (value <= price) && (value >= (price - cellHeightStep));

    // const step = $props.aggregationStep > 0 ? $props.aggregationStep : cellHeightStep;
    // return (value >= price) && (value < (price + step));
}

function convertPrice(price) {
    if (!price) return void 0;
    return `${_compactFmt.format(price)}$`;
}

function click(event) {
    if ($core.meta.tool !== 'Cursor') return;

    event.target.dispatchEvent(new CustomEvent("limit-order-clicked", {
        detail: {
            hoveredYAskValue,
            hoveredYBidValue,
            hoveredTimestamp,
            exchangeCode: hoveredExchangeCode,
            x: event.offsetX - 200,
            y: event.offsetY
        },
        bubbles: true
    }));
}

function mousemove(event) {
    const x = $core.cursor.time;
    const precision = Math.pow(10, $core.layout.prec);
    const roundedY = (Math.ceil($core.layout.y2value(event.offsetY) * precision) / precision);
    const y = roundedY.toFixed($core.layout.prec);
    hoveredLimitOrder = { x, y };
}

function mouseout() {
    hoveredLimitOrder = { x: 0, y: 0 };
    hoveredYAskValue = undefined;
    hoveredYBidValue = undefined;
    hoveredTimestamp = undefined;
    hoveredExchangeCode = undefined;
}

function gradient(val, type) {
    const max_value = 500_000;
    const opacityMin = 0.1;
    const opacityMax = 1;

    if (type === 'asks') {
        return d3.scaleLinear()
            .range([`rgba(255,0,0, ${opacityMin})`,
                `rgba(255,242,0, ${(opacityMin + opacityMax) / 2})`,
                `rgba(30,150,0, ${opacityMax})`])
            .domain([5_000, max_value]);
    }

    if (type === 'bids') {
        return d3.scaleLinear()
            .range([`rgba(30,150,0, ${opacityMin})`,
                `rgba(255,242,0, ${(opacityMin + opacityMax) / 2})`,
                `rgba(255,0,0, ${opacityMax})`])
            .domain([5_000, max_value]);
    }
}


static yRange(data) {
    let len = data.length
    var h, l, high = -Infinity, low = Infinity
    for (var i = 0; i < len; i++) {
        let point = data[i]
        if (point[2] > high) high = point[2]
        if (point[3] < low) low = point[3]
    }
    return [high, low]
}

